# ==============================================================================
# Store Keeper Client - Environment Variables Template
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# Backend REST API Base URL
# - When connecting to local NestJS backend: http://localhost:4000/v1
# - When using Next.js internal standalone mock routes: http://localhost:3000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# Supabase Authentication & Client Configuration
# Obtain these values from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

